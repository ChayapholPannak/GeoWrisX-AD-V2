{
  "name": "geowrisx-ad-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k -n api,web -c cyan,magenta \"wrangler pages dev dist --port 8788\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "check:functions": "node scripts/check-functions.mjs",
    "check": "npm run check:functions && npm run build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name geowrisx-ad-v2"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@clerk/localizations": "^4.24.4",
    "@clerk/react": "^6.18.4",
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7",
    "wrangler": "^4.156.0"
  }
}
